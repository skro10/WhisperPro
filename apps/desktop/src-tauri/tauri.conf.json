{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperPro",
  "version": "0.1.0",
  "identifier": "com.whisperpro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperPro",
        "width": 1100,
        "height": 740,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/bin/*"],
    "icon": ["icons/icon.ico"]
  }
}

