{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperPro",
  "version": "1.5.0",
  "identifier": "com.whisperpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperPro",
        "width": 1100,
        "height": 740,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "resources": ["resources/bin/*", "resources/redist/*"],
    "icon": ["icons/icon.ico"]
  }
}

